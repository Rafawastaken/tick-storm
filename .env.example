# Copy to .env and adjust. Read by docker-compose, the Makefile and the app.

# --------------------------- Application ---------------------------
APP_ENV=dev
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s

# ---------------------------- PostgreSQL ---------------------------
# localhost because the backend runs on the host (Air), not in a container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=toor
POSTGRES_DB=tickstorm
POSTGRES_SSLMODE=disable

# pgxpool connection pool
POSTGRES_MAX_CONNS=50
POSTGRES_MIN_CONNS=5

# ----------------------------- Ingestion ---------------------------
# Used by the worker binary only.
INGEST_SYMBOLS=BTCUSDT,ETHUSDT

# Empty uses the client default (wss://stream.binance.com:9443/stream).
BINANCE_WS_URL=

# ------------------------------ Redis ------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --------------------- Observability (compose) ---------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
